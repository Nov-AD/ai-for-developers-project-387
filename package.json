{
  "name": "ai-for-developers-project-386",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:build": "pnpm --filter @calendar/contract build",
    "sdk:build": "pnpm --filter @calendar/sdk generate",
    "api:types": "pnpm --filter @calendar/api types",
    "codegen": "pnpm contract:build && pnpm sdk:build && pnpm api:types",
    "build": "pnpm codegen && pnpm -r build",
    "dev": "pnpm codegen && pnpm -r --parallel dev",
    "test": "pnpm -r test && pnpm test:automation",
    "test:automation": "node --test scripts/*.test.mjs",
    "test:e2e": "pnpm --filter @calendar/sdk build && pnpm --filter @calendar/api build && VITE_API_URL= pnpm --filter @calendar/web build && pnpm --filter @calendar/web test:e2e",
    "test:smoke": "pnpm --filter @calendar/api test:smoke",
    "test:deployment": "node scripts/smoke-deployment.mjs",
    "typecheck": "pnpm --filter @calendar/sdk build && pnpm -r typecheck",
    "lint": "oxlint --deny-warnings apps packages scripts",
    "lint:fix": "oxlint --fix apps packages scripts",
    "lint:actions": "jactionlint .github/workflows/ci.yml .github/workflows/push-check.yml .github/workflows/security.yml .github/workflows/release-please.yml .github/workflows/auto-triage.yml .github/workflows/pr-review.yml .github/workflows/pr-head-e2e.yml",
    "skills:check": "node scripts/check-agent-skills.mjs",
    "secrets": "betterleaks git --redact --no-banner",
    "audit": "osv-scanner scan source --allow-no-lockfiles pnpm-lock.yaml .github/auto-triage/package-lock.json .github/manual-agent/package-lock.json",
    "commitlint:ci": "node scripts/check-commit-messages.mjs",
    "fmt": "oxfmt --write 'apps/**/*.{ts,tsx,js,jsx,json,css}' 'packages/**/*.{ts,tsx,js,jsx,json}' 'scripts/**/*.{js,mjs,ts}' '*.{json,js,ts}'",
    "fmt:check": "oxfmt --check 'apps/**/*.{ts,tsx,js,jsx,json,css}' 'packages/**/*.{ts,tsx,js,jsx,json}' 'scripts/**/*.{js,mjs,ts}' '*.{json,js,ts}'",
    "knip": "knip",
    "syncpack": "syncpack lint",
    "arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "contract:lint": "vacuum lint --min-score 90 packages/contract/tsp-output/openapi3/openapi.yaml",
    "contract:breaking": "node scripts/check-breaking-contract.mjs",
    "check": "pnpm lint && pnpm lint:actions && pnpm skills:check && pnpm fmt:check && pnpm typecheck && pnpm knip && pnpm syncpack && pnpm arch && pnpm contract:lint && pnpm test && pnpm test:e2e",
    "fix": "pnpm fmt && pnpm lint:fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "dependency-cruiser": "^18.8.0",
    "knip": "^6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "syncpack": "^15.3.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0"
}
